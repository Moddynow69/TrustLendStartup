rules_version = '2';

// Lead documents are only ever read or written through short-lived signed
// links that the server issues after checking the user's access (see
// src/lib/db/documents.ts). The Admin SDK and signed URLs bypass these
// rules, so browsers get no direct access to anything in the bucket.
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
