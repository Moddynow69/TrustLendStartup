rules_version = '2';

// Section 10 mandates: "Do NOT allow direct Firestore access from frontend"
// and "Use Firebase Admin SDK inside API routes". The Admin SDK bypasses
// these rules entirely, so this file exists purely as defense-in-depth:
// if a client ever tried to hit Firestore directly (misconfigured SDK,
// leaked config, etc.), everything is denied by default.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
