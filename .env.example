# --- Firebase Web API key (server-only, NEVER expose) ---
# Used by /api/auth/login to verify passwords via Firebase Auth's REST API.
# Create a dedicated key (Google Cloud Console -> APIs & Services ->
# Credentials -> Create API key), restricted to "Identity Toolkit API".
# Do not prefix it with NEXT_PUBLIC_ — the browser must never see it.
FIREBASE_WEB_API_KEY=

# --- Firebase Admin SDK (server-only, NEVER expose) ---
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
# Open the service account JSON you downloaded from Firebase Console
# (Project Settings -> Service Accounts -> Generate new private key) and
# copy the "private_key" field's value EXACTLY as it appears there,
# including the surrounding quotes and the literal \n characters — do not
# manually replace the \n with real line breaks and do not add or remove
# any characters. It must look like a single line, wrapped in double quotes:
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvQIBADANBgkqhkiG9w0BAQEFAASCBKcwggSjAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# --- App config ---
# Internal domain used to synthesize an email for username-based logins
AUTH_INTERNAL_EMAIL_DOMAIN=loanbandhu.internal
# Name of the secure, http-only cookie holding the Firebase ID token
SESSION_COOKIE_NAME=lb_session
# Session cookie lifetime in seconds (default 5 days)
SESSION_EXPIRES_IN_SECONDS=432000
